# WPShare configuration
# Copy to .env and fill in the required values.

# NODE_ENV=production

# Port to listen on
PORT=3000

# Interface to bind.
IP_ADDRESS=127.0.0.1

# Public origin used for share links
# PUBLIC_URL=https://yourdomain.com

# Time zone for dates on the admin page (IANA name, e.g. America/Toronto, UTC).
# DISPLAY_TIME_ZONE=America/Toronto

# Log verbosity: error, warn or info.
# LOG_LEVEL=info

# Number of reverse proxies in front of the app whose X-Forwarded-For header is trusted
# TRUST_PROXY=1

# Site name.
SITE_NAME="WPShare"

# Small line under the site name in the top bar.
SITE_TAGLINE="share WordPress plugins and themes"

# Show the small pill above the heading (true or false).
HERO_EYEBROW_ENABLED=true

# Text of that pill.
HERO_EYEBROW="SHARE YOUR CODE"

# Heading, white part.
HERO_TITLE="Drop your plugin or theme .zip,"

# Heading, gradient part (same line, violet-to-green).
HERO_TITLE_GRADIENT="get a link."

# Paragraph under the heading. Wrap words in `backticks` to show them as code.
HERO_INTRO="We read the `Plugin Name` or `Theme Name` header and turn the files into a shareable page."

# SQLite database file (its folder is created on start). Default: data/db.sqlite
# DB_PATH=/data/db.sqlite

# Directory for uploaded packages. Default: uploads/
# UPLOAD_DIR=/data/uploads

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Required. Admin login name.
ADMIN_USERNAME=admin
# Required. Use a long random password; login is rate limited to 10 attempts / 15 min / IP.
ADMIN_PASSWORD=

# Max size of the uploaded .zip itself, in MB. Default: 50
# MAX_UPLOAD_MB=50

# Max number of files kept from the zip (a whole-number count, not a size).
# MAX_ZIP_ENTRIES=2000

# Max combined uncompressed size of all kept files, in MB. Default: 100
# MAX_UNZIPPED_MB=100

# Max uncompressed size of any single file in the zip, in MB. Default: 5
# MAX_FILE_MB=5

# Files larger than this (0.256 MB = 256 KB) still appear in the tree and the download,
# but the share page shows "file too large to preview" instead of code. Default: 0.256
# MAX_PREVIEW_MB=0.256

# Total preview limit per package, in MB.
# MAX_PREVIEW_TOTAL_MB=2
