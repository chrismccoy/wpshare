{
  "name": "wpshare",
  "version": "1.0.0",
  "description": "Share WordPress plugins and themes by link",
  "main": "server.js",
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "build": "npm ci && npm run migrate && npm run css:build",
    "migrate": "knex migrate:latest --knexfile ./knexfile.js",
    "db:reset": "node -e \"require('fs').rmSync(process.env.DB_PATH || 'data/db.sqlite', {force:true})\" && npm run migrate",
    "build:css": "tailwindcss -i src/app.css -o public/css/app.css --minify"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "highlight.js": "^11.12.0",
    "knex": "^3.2.9",
    "morgan": "^1.10.1",
    "multer": "^2.5.0",
    "sqlite3": "^6.0.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19"
  }
}
