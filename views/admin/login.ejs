<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <%- include('../partials/layout/_head') %>
    <title>Admin Login — <%= site.name %></title>
  </head>
  <body class="bg-ink text-gray-200 font-sans min-h-screen flex items-center justify-center p-4 antialiased">
    <div class="w-full max-w-sm">

      <div class="flex flex-col items-center mb-8 gap-3">
        <%- include('../partials/layout/_topbar') %>
        <h1 class="text-2xl font-bold text-white tracking-tight">Admin Login</h1>
      </div>

      <div class="bg-panel border border-white/10 rounded-2xl p-7">
        <% if (error) { %>
          <div class="mb-5 px-4 py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-sm text-red-400">
            <%= error %>
          </div>
        <% } %>

        <form method="post" action="/admin/login">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <div class="space-y-4">
            <div>
              <label for="username" class="block text-sm font-medium text-gray-300 mb-1.5">Username</label>
              <input
                id="username"
                name="username"
                type="text"
                autocomplete="username"
                required
                class="w-full rounded-xl text-sm px-4 py-2.5 outline-none transition-all bg-black/40 border border-white/10 text-gray-200 placeholder:text-gray-500 focus:border-violet-400 focus:ring-2 focus:ring-violet-500/30"
              />
            </div>

            <div>
              <label for="password" class="block text-sm font-medium text-gray-300 mb-1.5">Password</label>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                class="w-full rounded-xl text-sm px-4 py-2.5 outline-none transition-all bg-black/40 border border-white/10 text-gray-200 placeholder:text-gray-500 focus:border-violet-400 focus:ring-2 focus:ring-violet-500/30"
              />
            </div>
          </div>

          <button
            type="submit"
            class="mt-6 w-full px-6 py-2.5 text-sm font-semibold rounded-lg transition-all cursor-pointer bg-white text-black hover:bg-gray-200"
          >
            Sign in
          </button>
        </form>
      </div>

    </div>
  </body>
</html>
